{
  "opencollection": "1.0.0",
  "info": {
    "name": "Chameleon REST Alert Groups Segments API",
    "version": "3"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-Account-Secret",
      "value": "{{X-Account-Secret}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Segments",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List segments",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.chameleon.io/v3/edit/segments"
          },
          "docs": "List segments"
        },
        {
          "info": {
            "name": "Retrieve a segment",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.chameleon.io/v3/edit/segments/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Retrieve a segment"
        }
      ]
    }
  ],
  "bundled": true
}