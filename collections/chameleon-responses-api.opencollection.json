{
  "opencollection": "1.0.0",
  "info": {
    "name": "Chameleon REST Alert Groups Responses API",
    "version": "3"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-Account-Secret",
      "value": "{{X-Account-Secret}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Responses",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List microsurvey responses",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.chameleon.io/v3/analyze/responses"
          },
          "docs": "List microsurvey responses"
        }
      ]
    }
  ],
  "bundled": true
}